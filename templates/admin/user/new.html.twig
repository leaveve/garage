{% extends 'base.html.twig' %}

{% block title %}Ajouter un membre du personnel — Administration{% endblock %}

{% block body %}
    <a href="{{ path('app_admin_user_index') }}" class="text-secondary text-decoration-none">← Retour à la liste</a>
    <h1 class="mt-3 mb-3">Ajouter un membre du personnel</h1>
    <p class="text-secondary mb-4">L'employé recevra un email d'invitation pour choisir lui-même son mot de passe.</p>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="row g-3">
            <div class="col-md-6">{{ form_row(form.prenom, {attr: {class: 'form-control'}}) }}</div>
            <div class="col-md-6">{{ form_row(form.nom, {attr: {class: 'form-control'}}) }}</div>
            <div class="col-md-6">{{ form_row(form.email, {attr: {class: 'form-control'}}) }}</div>
            <div class="col-md-6">{{ form_row(form.telephone, {attr: {class: 'form-control'}}) }}</div>
        </div>
        <button class="btn btn-light btn-lg mt-4">Envoyer l'invitation</button>
    {{ form_end(form) }}
{% endblock %}