{% extends 'base.html.twig' %}

{% block title %}Modifier la voiture — Garage{% endblock %}

{% block body %}
    <a href="{{ path('app_gestion_voiture_index') }}" class="text-secondary text-decoration-none">← Retour à la liste</a>
    <h1 class="mt-3 mb-4">Modifier : {{ voiture.modele.marque.libelle }} {{ voiture.modele.libelle }}</h1>

    {{ include('gestion/voiture/_form.html.twig', {button_label: 'Enregistrer les modifications'}) }}

    {% if is_granted('ROLE_ADMIN') %}
        <div class="mt-4">{{ include('gestion/voiture/_delete_form.html.twig') }}</div>
    {% endif %}
{% endblock %}