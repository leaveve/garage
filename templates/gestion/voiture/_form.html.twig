{{ form_start(form) }}
    {{ form_errors(form) }}

    <h5 class="mt-2 mb-3">La voiture</h5>
    <div class="row g-3">
        <div class="col-md-3">{{ form_row(form.marque, {attr: {class: 'form-select'}}) }}</div>
        <div class="col-md-3">
            {{ form_row(form.modele, {attr: {class: 'form-select'}}) }}
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_modele_new') }}" id="lien-ajout-modele" class="small text-secondary">
                    Modèle absent ? L'ajouter
                </a>
            {% endif %}
        </div>
        <div class="col-md-2">{{ form_row(form.annee, {attr: {class: 'form-control'}}) }}</div>
        <div class="col-md-2">{{ form_row(form.kilometrage, {attr: {class: 'form-control'}}) }}</div>
        <div class="col-md-2">{{ form_row(form.puissanceCh, {attr: {class: 'form-control'}}) }}</div>
        <div class="col-md-3">{{ form_row(form.transmission, {attr: {class: 'form-select'}}) }}</div>
        <div class="col-md-3">{{ form_row(form.carburant, {attr: {class: 'form-select'}}) }}</div>
        <div class="col-md-4">{{ form_row(form.couleur, {attr: {class: 'form-control'}}) }}</div>
        <div class="col-md-2">{{ form_row(form.couleurHex, {attr: {class: 'form-control form-control-color'}}) }}</div>
        <div class="col-12">{{ form_row(form.description, {attr: {class: 'form-control'}}) }}</div>
    </div>

    <h5 class="mt-4 mb-3">Vente et location</h5>
    <div class="row g-3">
        <div class="col-md-2 pt-4">{{ form_row(form.aVendre, {attr: {class: 'form-check-input'}}) }}</div>
        <div class="col-md-4">{{ form_row(form.prixVente, {attr: {class: 'form-control'}}) }}</div>
        <div class="col-md-6"></div>
        <div class="col-md-2 pt-4">{{ form_row(form.aLouer, {attr: {class: 'form-check-input'}}) }}</div>
        <div class="col-md-4">{{ form_row(form.prixLocationJour, {attr: {class: 'form-control'}}) }}</div>
        <div class="col-md-3">{{ form_row(form.caution, {attr: {class: 'form-control'}}) }}</div>
        <div class="col-md-3">{{ form_row(form.statut, {attr: {class: 'form-select'}}) }}</div>
    </div>

    <button class="btn btn-light btn-lg mt-4">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}

<script>
    (() => {
        const selectMarque = document.getElementById('voiture_marque');
        const selectModele = document.getElementById('voiture_modele');
        if (!selectMarque || !selectModele) return;

        // Recharge la liste des modèles de la marque choisie
        async function chargerModeles(garderSelection) {
            // Le lien « Modèle absent ? » pré-sélectionne la marque choisie
            const lien = document.getElementById('lien-ajout-modele');
            if (lien) {
                lien.href = '/admin/modele/new' + (selectMarque.value ? '?marque=' + selectMarque.value : '');
            }

            const modeleActuel = garderSelection ? selectModele.value : '';
            selectModele.innerHTML = '<option value="">Choisir un modèle</option>';

            if (!selectMarque.value) {
                selectModele.disabled = true;
                return;
            }

            // Appel de la route JSON
            const reponse = await fetch('/gestion/voiture/modeles/' + selectMarque.value);
            const modeles = await reponse.json();

            modeles.forEach(modele => {
                const option = new Option(modele.libelle, modele.id);
                if (String(modele.id) === modeleActuel) {
                    option.selected = true;
                }
                selectModele.add(option);
            });
            selectModele.disabled = false;
        }

        
        selectMarque.addEventListener('change', () => chargerModeles(false));

        chargerModeles(true);
    })();
</script>