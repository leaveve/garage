{% extends 'base.html.twig' %}

{% block title %}Catalogue — Garage{% endblock %}

{% block body %}
    <h1 class="mb-4">Notre catalogue</h1>

    {% if voitures is empty %}
        <p class="text-secondary">Aucune voiture disponible pour le moment.</p>
    {% else %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for voiture in voitures %}
                <div class="col">
                    {% include 'partials/carte_voiture.html.twig' %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}