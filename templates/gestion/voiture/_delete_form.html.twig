<form method="post" action="{{ path('app_gestion_voiture_delete', {id: voiture.id}) }}"
      onsubmit="return confirm('Supprimer définitivement cette voiture ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ voiture.id) }}">
    <button class="btn btn-outline-danger">Supprimer la voiture</button>
</form>