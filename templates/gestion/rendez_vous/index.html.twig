{% extends 'base.html.twig' %}

{% block title %}Gestion des rendez-vous — Drift Club{% endblock %}

{% block body %}
    <p class="surtitre mb-2">Back-office</p>
    <h1 class="mb-4">Rendez-<span class="grad">vous</span></h1>

    {% set colonnes = [
        {titre: 'En attente', statuts: ['en_attente'], classe: 'statut-en_attente'},
        {titre: 'Acceptés', statuts: ['accepte'], classe: 'statut-accepte'},
        {titre: 'Terminés', statuts: ['termine'], classe: 'statut-termine'},
        {titre: 'Refusés & annulés', statuts: ['refuse', 'annule'], classe: 'statut-refuse'}
    ] %}

    {% set actions = {
        'en_attente': {'accepte': 'Accepter', 'refuse': 'Refuser'},
        'accepte': {'termine': 'Terminer', 'refuse': 'Refuser'}
    } %}

    <div class="kanban">
        {% for colonne in colonnes %}
            {% set liste = rendezVous|filter(r => r.statut in colonne.statuts) %}
            <div class="kanban-colonne {{ colonne.classe }}">
                <div class="kanban-entete">
                    <span class="point"></span>
                    {{ colonne.titre }}
                    <span class="compteur">{{ liste|length }}</span>
                </div>

                {% for rdv in liste %}
                    {% set photo = rdv.voiture.photos|first %}
                    <div class="rdv-carte statut-{{ rdv.statut }}">
                        <div class="rdv-photo" {% if photo %}style="background-image: url('{{ asset('uploads/voitures/' ~ photo.nomFichier) }}')"{% endif %}>
                            <span class="badge badge-location rdv-motif">{{ rdv.motif|capitalize }}</span>
                        </div>
                        <div class="rdv-corps">
                            <a href="{{ path('app_voiture_show', {id: rdv.voiture.id}) }}" class="rdv-voiture">
                                {{ rdv.voiture.modele.marque.libelle }} {{ rdv.voiture.modele.libelle }}
                            </a>

                            <div class="rdv-ligne">📅 <strong>{{ rdv.dateHeure|date('d/m/Y à H:i') }}</strong></div>
                            {% if rdv.motif == 'location' and rdv.dateDebutLocation %}
                                <div class="rdv-ligne">🔑 du {{ rdv.dateDebutLocation|date('d/m') }} au {{ rdv.dateFinLocation|date('d/m/Y') }}</div>
                            {% endif %}

                            <div class="rdv-ligne">👤 <strong>{{ rdv.client.prenom }} {{ rdv.client.nom }}</strong></div>
                            <div class="rdv-ligne">✉️ {{ rdv.client.email }}</div>
                            {% if rdv.client.telephone %}
                                <div class="rdv-ligne">📞 {{ rdv.client.telephone }}</div>
                            {% endif %}
                            {% if rdv.motif == 'location' %}
                                <div class="rdv-ligne">
                                    🪪
                                    {% if rdv.client.dateNaissance %}{{ rdv.client.dateNaissance.diff(date()).y }} ans{% else %}âge inconnu{% endif %}
                                    ·
                                    {% if rdv.client.datePermis %}permis depuis {{ rdv.client.datePermis.diff(date()).y }} ans{% else %}permis non renseigné{% endif %}
                                </div>
                            {% endif %}

                            {% if rdv.message %}
                                <div class="rdv-message">« {{ rdv.message }} »</div>
                            {% endif %}

                            {% if actions[rdv.statut] is defined %}
                                <div class="rdv-actions">
                                    {% for nouveau, libelle in actions[rdv.statut] %}
                                        <form method="post" action="{{ path('app_gestion_rdv_statut', {id: rdv.id}) }}" class="statut-{{ nouveau }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('statut' ~ rdv.id) }}">
                                            <input type="hidden" name="statut" value="{{ nouveau }}">
                                            <button class="btn btn-sm btn-statut">{{ libelle }}</button>
                                        </form>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <div class="kanban-vide">Aucun rendez-vous</div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
{% endblock %}
