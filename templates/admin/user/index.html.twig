{% extends 'base.html.twig' %}

{% block title %}Comptes — Administration{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Comptes</h1>
        <a href="{{ path('app_admin_user_new') }}" class="btn btn-light">+ Ajouter un membre du personnel</a>
    </div>

    {# Filtres par rôle #}
    {% set filtres = {'': 'Tous', 'staff': 'Personnel', 'client': 'Clients'} %}
    <div class="mb-4">
        {% for valeur, label in filtres %}
            <a href="{{ path('app_admin_user_index', valeur ? {role: valeur} : {}) }}"
               class="btn btn-sm {{ roleActuel == valeur ? 'btn-light' : 'btn-outline-light' }} me-1">
                {{ label }}
            </a>
        {% endfor %}
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Rôle</th>
                    <th>Inscrit le</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.prenom }} {{ user.nom }}</td>
                        <td>
                            {{ user.email }}
                            {% if user.telephone %}<br><small class="text-secondary">{{ user.telephone }}</small>{% endif %}
                        </td>
                        <td>
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="badge bg-danger">Gérant</span>
                            {% elseif 'ROLE_STAFF' in user.roles %}
                                <span class="badge bg-warning text-dark">Personnel</span>
                            {% else %}
                                <span class="badge bg-secondary">Client</span>
                            {% endif %}
                        </td>
                        <td>{{ user.dateInscription|date('d/m/Y') }}</td>
                        <td>
                            {% if user.actif %}
                                <span class="badge bg-success">Actif</span>
                            {% else %}
                                <span class="badge bg-dark border border-danger text-danger">Bloqué</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            {# Pas d'action sur son propre compte #}
                            {% if user != app.user %}
                                <form method="post" action="{{ path('app_admin_user_bloquer', {id: user.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('bloquer' ~ user.id) }}">
                                    <button class="btn btn-sm {{ user.actif ? 'btn-outline-warning' : 'btn-outline-success' }}">
                                        {{ user.actif ? 'Bloquer' : 'Débloquer' }}
                                    </button>
                                </form>
                                <form method="post" action="{{ path('app_admin_user_supprimer', {id: user.id}) }}" class="d-inline"
                                      onsubmit="return confirm('Supprimer définitivement ce compte ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ user.id) }}">
                                    <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            {% else %}
                                <small class="text-secondary">Vous</small>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-secondary">Aucun compte.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}