{% extends 'base.html.twig' %}

{% block title %}Mon profil — Garage{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h1>Mon profil</h1>
        <a href="{{ path('app_profil_mot_de_passe') }}" class="btn btn-outline-light">Changer mon mot de passe</a>
    </div>
    <p class="text-secondary mb-4">
        {{ app.user.email }} · inscrit le {{ app.user.dateInscription|date('d/m/Y') }}
    </p>

    {{ form_start(form) }}
        {{ form_errors(form) }}

        <h5 class="mb-3">Identité</h5>
        <div class="row g-3">
            <div class="col-md-4">{{ form_row(form.prenom, {attr: {class: 'form-control'}}) }}</div>
            <div class="col-md-4">{{ form_row(form.nom, {attr: {class: 'form-control'}}) }}</div>
            <div class="col-md-4">{{ form_row(form.telephone, {attr: {class: 'form-control'}}) }}</div>
            <div class="col-md-4">{{ form_row(form.dateNaissance, {attr: {class: 'form-control'}}) }}</div>
        </div>

        <h5 class="mt-4 mb-3">Adresse</h5>
        <div class="row g-3">
            <div class="col-md-6">{{ form_row(form.adresse, {attr: {class: 'form-control'}}) }}</div>
            <div class="col-md-2">{{ form_row(form.codePostal, {attr: {class: 'form-control'}}) }}</div>
            <div class="col-md-4">{{ form_row(form.ville, {attr: {class: 'form-control'}}) }}</div>
        </div>

        <h5 class="mt-4 mb-3">Permis de conduire</h5>
        <p class="text-secondary small">Nécessaire pour louer une voiture : le garage vérifiera votre permis sur place.</p>
        <div class="row g-3">
            <div class="col-md-4">{{ form_row(form.datePermis, {attr: {class: 'form-control'}}) }}</div>
        </div>

        <button class="btn btn-light btn-lg mt-4">Enregistrer</button>
    {{ form_end(form) }}
{% endblock %}
