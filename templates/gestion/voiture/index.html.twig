{% extends 'base.html.twig' %}

{% block title %}Gestion des voitures — Drift Club{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des voitures</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_gestion_voiture_new') }}" class="btn btn-light">+ Ajouter une voiture</a>
        {% endif %}
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Photo</th>
                    <th>Voiture</th>
                    <th>Année · km</th>
                    <th>Vente</th>
                    <th>Location</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for voiture in voitures %}
                    <tr>
                        <td>
                            {% set photo = voiture.photos|first %}
                            {% if photo %}
                                <img src="{{ asset('uploads/voitures/' ~ photo.nomFichier) }}"
                                     class="rounded" style="width:80px" alt="">
                            {% endif %}
                        </td>
                        <td>
                            <small class="text-secondary">{{ voiture.modele.marque.libelle }}</small><br>
                            {{ voiture.modele.libelle }}
                        </td>
                        <td>{{ voiture.annee }} · {{ voiture.kilometrage|number_format(0, ',', ' ') }} km</td>
                        <td>
                            {{ voiture.aVendre ? voiture.prixVente|number_format(0, ',', ' ') ~ ' €' : '—' }}
                        </td>
                        <td>
                            {{ voiture.aLouer ? voiture.prixLocationJour|number_format(0, ',', ' ') ~ ' € / j' : '—' }}
                        </td>
                        <td>
                            {% if voiture.statut == 'disponible' %}
                                <span class="badge bg-success">Disponible</span>
                            {% elseif voiture.statut == 'louee' %}
                                <span class="badge bg-info text-dark">Louée</span>
                            {% else %}
                                <span class="badge bg-secondary">Vendue</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_voiture_show', {id: voiture.id}) }}" class="btn btn-sm btn-outline-light">Voir</a>
                            <a href="{{ path('app_gestion_voiture_edit', {id: voiture.id}) }}" class="btn btn-sm btn-light">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-secondary">Aucune voiture.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}