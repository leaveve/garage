{% extends 'base.html.twig' %}

{% block title %}Créer un compte — Drift Club{% endblock %}

{% block body %}
    <div class="carte-auth">
        <h1 class="h3 mb-4">Créer un compte</h1>

        {{ form_start(registrationForm) }}
            {{ form_errors(registrationForm) }}

            <div class="row g-3">
                <div class="col-sm-6">{{ form_row(registrationForm.prenom, {label: 'Prénom', attr: {class: 'form-control'}}) }}</div>
                <div class="col-sm-6">{{ form_row(registrationForm.nom, {label: 'Nom', attr: {class: 'form-control'}}) }}</div>
                <div class="col-12">{{ form_row(registrationForm.email, {label: 'Email', attr: {class: 'form-control'}}) }}</div>
                <div class="col-12">{{ form_row(registrationForm.plainPassword, {label: 'Mot de passe', attr: {class: 'form-control'}}) }}</div>
            </div>

            <div class="form-check mt-3">
                {{ form_widget(registrationForm.agreeTerms, {attr: {class: 'form-check-input'}}) }}
                <label class="form-check-label text-secondary" for="{{ registrationForm.agreeTerms.vars.id }}">
                    J'accepte les conditions d'utilisation
                </label>
                {{ form_errors(registrationForm.agreeTerms) }}
            </div>

            <button type="submit" class="btn btn-light btn-lg w-100 mt-4">Créer mon compte</button>
        {{ form_end(registrationForm) }}

        <p class="text-center text-secondary mt-4 mb-0">
            Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
        </p>
    </div>
{% endblock %}
