{% extends 'base.html.twig' %}

{% block title %}Modifier la voiture — Drift Club{% endblock %}

{% block body %}
    <a href="{{ path('app_gestion_voiture_index') }}" class="text-secondary text-decoration-none">← Retour à la liste</a>
    <h1 class="mt-3 mb-4">Modifier : {{ voiture.modele.marque.libelle }} {{ voiture.modele.libelle }}</h1>

    {# Galerie : en dehors du formulaire de la voiture (pas de form dans un form) #}
    {% if voiture.photos is not empty %}
        <h5 class="mb-3">Photos actuelles</h5>
        <div class="d-flex flex-wrap gap-3 mb-4">
            {% for photo in voiture.photos %}
                <div class="card bg-black border-secondary" style="width: 160px">
                    <img src="{{ asset('uploads/voitures/' ~ photo.nomFichier) }}" class="card-img-top" alt="">
                    <div class="card-body p-2 text-center">
                        {% if loop.first %}
                            <span class="badge bg-success mb-2">Principale</span>
                        {% else %}
                            <form method="post" action="{{ path('app_gestion_photo_principale', {id: photo.id}) }}" class="mb-1">
                                <input type="hidden" name="_token" value="{{ csrf_token('photo' ~ photo.id) }}">
                                <button class="btn btn-sm btn-outline-light w-100">Principale</button>
                            </form>
                        {% endif %}
                        <form method="post" action="{{ path('app_gestion_photo_supprimer', {id: photo.id}) }}"
                              onsubmit="return confirm('Supprimer cette photo ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('photo' ~ photo.id) }}">
                            <button class="btn btn-sm btn-outline-danger w-100">Supprimer</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {{ include('gestion/voiture/_form.html.twig', {button_label: 'Enregistrer les modifications'}) }}

    {% if is_granted('ROLE_ADMIN') %}
        <div class="mt-4">{{ include('gestion/voiture/_delete_form.html.twig') }}</div>
    {% endif %}
{% endblock %}