{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe — Drift Club{% endblock %}

{% block body %}
    <a href="{{ path('app_profil') }}" class="text-secondary text-decoration-none">← Retour à mon profil</a>
    <h1 class="mt-3 mb-4">Changer mon mot de passe</h1>

    <div class="col-md-6">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.ancienMotDePasse, {attr: {class: 'form-control'}}) }}
            {{ form_row(form.nouveauMotDePasse.first, {attr: {class: 'form-control'}}) }}
            {{ form_row(form.nouveauMotDePasse.second, {attr: {class: 'form-control'}}) }}
            <button class="btn btn-light btn-lg w-100 mt-3">Changer le mot de passe</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
