{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — Drift Club{% endblock %}

{% block body %}
    <div class="col-md-6 mx-auto">
        <h1 class="mb-3">Choisissez votre mot de passe</h1>

        {{ form_start(resetForm) }}
            {{ form_errors(resetForm) }}
            {{ form_row(resetForm.plainPassword.first, {label: 'Nouveau mot de passe', attr: {class: 'form-control'}}) }}
            {{ form_row(resetForm.plainPassword.second, {label: 'Confirmer le mot de passe', attr: {class: 'form-control'}}) }}
            <button class="btn btn-light w-100 mt-3">Enregistrer</button>
        {{ form_end(resetForm) }}
    </div>
{% endblock %}