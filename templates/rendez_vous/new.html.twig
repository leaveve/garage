{% extends 'base.html.twig' %}

{% block title %}Demande de rendez-vous — Drift Club{% endblock %}

{% block body %}
    <a href="{{ path('app_voiture_show', {id: voiture.id}) }}" class="text-secondary text-decoration-none">← Retour à la voiture</a>

    <h1 class="mt-3">Demander un rendez-vous</h1>
    <p class="text-secondary">
        {{ voiture.modele.marque.libelle }} {{ voiture.modele.libelle }} · {{ voiture.annee }}
    </p>

    <div class="col-lg-6">
       {{ form_start(form) }}
    {{ form_errors(form) }} {# affiche les erreurs générales #}

    {{ form_row(form.motif, {attr: {class: 'form-select'}}) }}
    {{ form_row(form.dateHeure, {attr: {class: 'form-control'}}) }}

    {% if voiture.aLouer %}
        <p class="text-secondary small mt-3">Pour une location, indiquez les dates :</p>
        {{ form_row(form.dateDebutLocation, {attr: {class: 'form-control'}}) }}
        {{ form_row(form.dateFinLocation, {attr: {class: 'form-control'}}) }}
    {% endif %}

    {{ form_row(form.message, {attr: {class: 'form-control'}}) }}

    <button class="btn btn-light btn-lg w-100 mt-3">Envoyer la demande</button>

    {{ form_widget(form._token) }} {# le jeton CSRF caché #}
{{ form_end(form, {render_rest: false}) }}
    </div>
{% endblock %}