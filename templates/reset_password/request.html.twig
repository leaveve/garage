{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — Drift Club{% endblock %}

{% block body %}
    <div class="col-md-6 mx-auto">
        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="alert alert-danger">{{ flash_error }}</div>
        {% endfor %}

        <h1 class="mb-3">Mot de passe oublié</h1>
        <p class="text-secondary">Saisissez votre adresse email, nous vous enverrons un lien pour choisir un nouveau mot de passe.</p>

        {{ form_start(requestForm) }}
            {{ form_row(requestForm.email, {label: 'Adresse email', attr: {class: 'form-control'}}) }}
            <button class="btn btn-light w-100 mt-3">Envoyer le lien</button>
        {{ form_end(requestForm) }}

        <p class="mt-3"><a href="{{ path('app_login') }}" class="text-secondary">← Retour à la connexion</a></p>
    </div>
{% endblock %}