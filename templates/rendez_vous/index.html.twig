{% extends 'base.html.twig' %}

{% block title %}Mes rendez-vous — Drift Club{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <p class="surtitre mb-2">Mon espace</p>
            <h1 class="mb-0">Mes rendez-<span class="grad">vous</span></h1>
        </div>
        <a href="{{ path('app_catalogue') }}" class="btn btn-light">Nouvelle demande →</a>
    </div>

    {% if rendezVous is empty %}
        <div class="kanban-vide py-5">
            <p class="mb-3">Vous n'avez encore aucune demande de rendez-vous.</p>
            <a href="{{ path('app_catalogue') }}" class="btn btn-outline-light">Voir le catalogue</a>
        </div>
    {% else %}
        {% set colonnes = [
            {titre: 'En attente', statuts: ['en_attente'], classe: 'statut-en_attente'},
            {titre: 'Acceptés', statuts: ['accepte'], classe: 'statut-accepte'},
            {titre: 'Terminés', statuts: ['termine'], classe: 'statut-termine'},
            {titre: 'Refusés & annulés', statuts: ['refuse', 'annule'], classe: 'statut-refuse'}
        ] %}

        <div class="kanban">
            {% for colonne in colonnes %}
                {% set liste = rendezVous|filter(r => r.statut in colonne.statuts) %}
                <div class="kanban-colonne {{ colonne.classe }}">
                    <div class="kanban-entete">
                        <span class="point"></span>
                        {{ colonne.titre }}
                        <span class="compteur">{{ liste|length }}</span>
                    </div>

                    {% for rdv in liste %}
                        {% set photo = rdv.voiture.photos|first %}
                        <div class="rdv-carte statut-{{ rdv.statut }}">
                            <div class="rdv-photo" {% if photo %}style="background-image: url('{{ asset('uploads/voitures/' ~ photo.nomFichier) }}')"{% endif %}>
                                <span class="badge badge-location rdv-motif">{{ rdv.motif|capitalize }}</span>
                            </div>
                            <div class="rdv-corps">
                                <a href="{{ path('app_voiture_show', {id: rdv.voiture.id}) }}" class="rdv-voiture">
                                    {{ rdv.voiture.modele.marque.libelle }} {{ rdv.voiture.modele.libelle }}
                                </a>

                                <div class="rdv-ligne">📅 <strong>{{ rdv.dateHeure|date('d/m/Y à H:i') }}</strong></div>
                                {% if rdv.motif == 'location' and rdv.dateDebutLocation %}
                                    <div class="rdv-ligne">🔑 du {{ rdv.dateDebutLocation|date('d/m') }} au {{ rdv.dateFinLocation|date('d/m/Y') }}</div>
                                {% endif %}
                                <div class="rdv-ligne">🕒 Demandé le {{ rdv.dateCreation|date('d/m/Y') }}</div>
                                {% if rdv.statut == 'annule' %}
                                    <div class="rdv-ligne">Annulé par vous</div>
                                {% endif %}

                                {% if rdv.message %}
                                    <div class="rdv-message">« {{ rdv.message }} »</div>
                                {% endif %}

                                {% if rdv.statut == 'en_attente' %}
                                    <div class="rdv-actions">
                                        <form method="post" action="{{ path('app_rendez_vous_annuler', {id: rdv.id}) }}" class="statut-refuse"
                                              onsubmit="return confirm('Annuler cette demande de rendez-vous ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ rdv.id) }}">
                                            <button class="btn btn-sm btn-statut">Annuler la demande</button>
                                        </form>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <div class="kanban-vide">Aucun rendez-vous</div>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
